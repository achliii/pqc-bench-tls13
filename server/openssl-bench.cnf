# Configuración OpenSSL del servidor PQC-Bench.
# Reemplaza la de la imagen OQS para (1) cargar oqs-provider y (2) fijar
# NumTickets = 0: en TLS 1.3 nginx sigue enviando NewSessionTicket aunque
# ssl_session_tickets esté en off, y el experimento exige reanudación desactivada.
openssl_conf = openssl_init

[openssl_init]
providers = provider_sect
ssl_conf = ssl_sect

[provider_sect]
default = default_sect
oqsprovider = oqsprovider_sect

[default_sect]
activate = 1

[oqsprovider_sect]
activate = 1

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1.3
NumTickets = 0
